{
  "name": "@local/cp-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH 插件：/cp-docs + 自然语言按机型检索本地产品资料（参数/接口/线束/编程节点/工作点），把事实交给模型作答",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/*",
    "data/*",
    "data/**",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "index.json"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "import": "node lib/import.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "author": "Alone-show",
  "homepage": "https://github.com/Alone-show/cp-docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alone-show/cp-docs.git"
  },
  "bugs": {
    "url": "https://github.com/Alone-show/cp-docs/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "product-docs",
    "retrieval",
    "cpdevice"
  ]
}